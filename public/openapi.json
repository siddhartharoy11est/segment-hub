    "/v1/lists/{name}/versions": {
      "post": {
        "summary": "Change an exclusion list",
        "description": "Adding sites narrows reach, so it publishes at once with one person and a reason (201). Removing a site widens reach, so it waits for an approver (202).",
        "tags": [
          "Author"
        ],
        "x-who-calls": "AdOps (writer)",
        "responses": {
          "201": {
            "description": "Example from the seeded demo",
            "content": {
              "application/json": {
                "example": {
                  "list": "excl_buyer_blocklist",
                  "version": 3,
                  "status": "active",
                  "catalog_rev": 6,
                  "affected_segments": [
                    {
                      "segment_id": "seg_glowroot_festive_east",
                      "new_effective_fingerprint": "38218f9b",
                      "previous": "4e64b9d1"
                    },
                    {
                      "segment_id": "seg_glowroot_premium_north",
                      "new_effective_fingerprint": "3f50fb78",
                      "previous": "b1d79b13"
                    }
                  ],
                  "review": "Adding sites only narrows reach, so one person may publish it with a reason. Removing a site needs an approver."
                }
              }
            }
          },
          "202": {
            "description": "listRemove",
            "content": {
              "application/json": {
                "example": {
                  "list": "excl_buyer_blocklist",
                  "status": "waiting_for_approval",
                  "pending": {
                    "add": [],
                    "remove": [
                      "viral-feed.example"
                    ],
                    "created_by": "priya",
                    "created_at": "2026-11-24T21:16:09.064Z",
                    "reason": "Buyer unblocked the site"
                  },
                  "next": "approve, by someone other than priya",
                  "why": "Removing a site from an exclusion list widens reach, so a second person must approve it."
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "add": [
                  "new-spam.example"
                ],
                "reason": "Buyer flagged the site as off-brand"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Replays the first response for the same key and body. A different body with the same key is refused with 422."
          }
        ]
      }
    },
