{
  "openapi": "3.0.3",
  "info": {
    "title": "Segment Hub API",
    "version": "1.0.0-prototype",
    "description": "Internal control-plane API for targeting segments behind curated deals. Prototype for the Media.net APM case, Topic 3. Not an official Media.net API. The hub is never called during the auction: servers read a small signed head, pull signed snapshots, match locally, and report what they serve. One rule decides who may act alone: anything that can only stop or narrow delivery needs one person and a reason; anything that can widen reach needs a second person."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Demo tokens identify people (writer, approver, reader, admin) and machines (one per server instance). Production: OAuth2 client credentials or mutual TLS for machines, the company identity provider for people."
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "x-errors": {
    "format": {
      "error": "machine_code",
      "message": "human sentence",
      "path": "where in the body, when relevant"
    },
    "codes": {
      "400": "invalid body or rule, with a did-you-mean where possible",
      "401": "no or unknown token",
      "403": "role or four-eyes refusal",
      "404": "not found, or not visible to your advertiser",
      "409": "wrong state, duplicate, or corrupt copy (hash mismatch)",
      "413": "rule too large",
      "422": "idempotency key reused with a different body",
      "429": "rate or prototype limit",
      "503": "hub API down; the head stays readable from object storage"
    }
  },
  "paths": {
    "/v1/segments": {
      "post": {
        "summary": "Create a segment",
        "description": "Creates version 1 in draft, bound to its Deal IDs. The rule is validated before it is saved; audience conditions get a consent tag.",
        "tags": [
          "Author"
        ],
        "x-who-calls": "AdOps (writer)",
        "responses": {
          "201": {
            "description": "Example from the seeded demo",
            "content": {
              "application/json": {
                "example": {
                  "segment_id": "seg_glowroot_monsoon_care",
                  "version": 1,
                  "status": "draft",
                  "fingerprint": "547a978d",
                  "deal_ids": [
                    "MN-GLOW-MONSOON"
                  ],
                  "validation": {
                    "valid": true,
                    "warnings": [
                      "audience.purchase_skincare_30d needs consent: tag added automatically"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "createSegment typo",
            "content": {
              "application/json": {
                "example": {
                  "error": "invalid_rule",
                  "message": "Unknown field 'device.geo.regoin'. Did you mean 'device.geo.region'?",
                  "rule_index": 0,
                  "path": "must[0].field",
                  "details": [
                    {
                      "error": "invalid_rule",
                      "message": "Unknown field 'device.geo.regoin'. Did you mean 'device.geo.region'?",
                      "path": "must[0].field",
                      "suggestion": "device.geo.region"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "GlowRoot Monsoon Care",
                "advertiser_id": "adv_glowroot",
                "deal_ids": [
                  "MN-GLOW-MONSOON"
                ],
                "rule": {
                  "must": [
                    {
                      "field": "device.geo.region",
                      "in": [
                        "IN-WB",
                        "IN-OD"
                      ]
                    },
                    {
                      "field": "device.type",
                      "in": [
                        "mobile"
                      ]
                    },
                    {
                      "field": "site.domain",
                      "not_in_list": "excl_buyer_blocklist"
                    }
                  ],
                  "should": [
                    {
                      "tier": 1,
                      "all": [
                        {
                          "field": "audience.purchase_skincare_30d",
                          "eq": true
                        },
                        {
                          "field": "site.cat",
                          "in": [
                            "IAB18-1"
                          ]
                        }
                      ]
                    },
                    {
                      "tier": 2,
                      "all": [
                        {
                          "field": "site.cat",
                          "in": [
                            "IAB18-1"
                          ]
                        }
                      ]
                    }
                  ],
                  "if_audience_missing": "fall_back_to_context"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Replays the first response for the same key and body. A different body with the same key is refused with 422."
          }
        ]
      }
    },
    "/v1/segments/{id}/versions": {
