    "/v1/catalog/snapshot": {
      "get": {
        "summary": "Pull the catalog",
        "description": "Signed delta since a revision, with ETag (If-None-Match returns 304). A cold start or a too-old revision returns a manifest to a signed object-store copy instead.",
        "tags": [
          "Distribute"
        ],
        "x-who-calls": "Ad servers and the deal tagger",
        "responses": {
          "200": {
            "description": "snapshot cold",
            "content": {
              "application/json": {
                "example": {
                  "mode": "object_url",
                  "reason": "cold start",
                  "catalog_rev": 7,
                  "url": "/v1/catalog/objects/rev-7.json?exp=1795555269070&sig=sig_fc793b77d6a2e75b",
                  "expires_at": "2026-11-24T21:21:09.070Z",
                  "body_digest": "b0fb6f98"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "since_rev",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/consumers/{id}/acks": {
      "post": {
        "summary": "Report what a server runs",
        "description": "The server identity comes from its token, never the body. Only state active at the current revision counts as in sync. The reply says sync_required; it never contains a stop command.",
