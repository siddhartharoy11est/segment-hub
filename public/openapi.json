    "/v1/segments/{id}/transitions": {
      "post": {
        "summary": "Move a segment through its lifecycle",
        "description": "submit, approve, publish, rollback, pause (stop everywhere), resume. Submit returns the blast radius. Approve, publish and resume need an approver who did not create the version; pause and a rollback that is not wider may be done by one person with a reason.",
        "tags": [
          "Approve"
        ],
        "x-who-calls": "AdOps and approvers",
        "responses": {
          "200": {
            "description": "pause",
            "content": {
              "application/json": {
                "example": {
                  "segment_id": "seg_glowroot_festive_east",
                  "status": "stopped_everywhere",
                  "catalog_rev": 8,
                  "how": "The segment is now on the revoked list in the head. Every server stops it on its next head read, within 30 seconds, even a server whose reload is failing.",
                  "not_yet_confirmed": [],
                  "next": "resume needs an approver, because it restores reach"
                }
              }
            }
          },
          "403": {
            "description": "resume writer",
            "content": {
              "application/json": {
                "example": {
                  "error": "forbidden",
                  "message": "Role 'writer' cannot do this. Needs: approver or admin"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "action": "submit",
                "version": 2
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Replays the first response for the same key and body. A different body with the same key is refused with 422."
          }
        ]
      }
    },
    "/v1/catalog/head": {
