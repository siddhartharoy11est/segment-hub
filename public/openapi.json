        "summary": "Read the head",
        "description": "A small signed document every server reads every 30 seconds: current revision, revoked segments, and for each segment what a server must do if it holds an older copy (on_server, after_seconds). Mirrored at /v1/catalog/objects/head.json, readable without a token.",
        "tags": [
          "Distribute"
        ],
        "x-who-calls": "Ad servers and the deal tagger",
        "responses": {
          "200": {
            "description": "Example from the seeded demo",
            "content": {
              "application/json": {
                "example": {
                  "catalog_rev": 7,
                  "hash": "42ac4889",
                  "published_at": "2026-11-24T21:16:09.064Z",
                  "revoked": [],
                  "segments": {
                    "seg_glowroot_festive_east": {
                      "fingerprint": "db3738a7",
                      "deal_ids": [
                        "MN-GLOW-FESTIVE-E"
                      ],
                      "expiry_class": "standard",
                      "if_holding_older": [
                        {
                          "fingerprint": "38218f9b",
                          "held_copy": "narrower",
                          "on_server": "keep_serving",
                          "after_seconds": null
                        },
                        {
                          "fingerprint": "4e64b9d1",
                          "held_copy": "mixed",
                          "on_server": "context_only_after",
                          "after_seconds": 14400
                        }
                      ],
                      "if_holding_unknown": {
                        "held_copy": "unknown",
                        "on_server": "context_only_after",
                        "after_seconds": 14400
                      }
                    },
                    "seg_glowroot_premium_north": {
                      "fingerprint": "683090d4",
                      "deal_ids": [
                        "MN-GLOW-PREMIUM-N"
                      ],
                      "expiry_class": "strict",
                      "if_holding_older": [
                        {
                          "fingerprint": "3f50fb78",
                          "held_copy": "narrower",
                          "on_server": "keep_serving",
                          "after_seconds": null
                        },
                        {
                          "fingerprint": "b1d79b13",
                          "held_copy": "mixed",
                          "on_server": "stop_after",
                          "after_seconds": 900
                        }
                      ],
                      "if_holding_unknown": {
                        "held_copy": "unknown",
                        "on_server": "stop_after",
                        "after_seconds": 900
                      }
                    }
                  },
                  "lease_seconds": {
                    "strict": 900,
